# Auto detect text files and perform LF normalization
* text=auto

# Source files
*.cpp text eol=lf
*.h text eol=lf
*.c text eol=lf
*.go text eol=lf
*.rs text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.xml text eol=lf
*.sql text eol=lf
*.lua text eol=lf
*.sh text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.conf text eol=lf
*.toml text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.mpq binary
*.dbc binary
*.wdt binary
*.adt binary
*.mp3 binary
*.wav binary

